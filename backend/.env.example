# Campus Resource Exchange Backend Configuration (Phase 2 & 3)
# Environment: development / production
ENVIRONMENT=development
DEBUG=True

# PostgreSQL Database Connection URL (psycopg v3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/campus_resources

# Security & JWT Token Configuration
# Generate a strong 32+ character random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=cre-insecure-dev-secret-key-replace-in-production-32-bytes-min!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Administrator Bootstrap (Optional for local setup)
# If provided, running the seed script will create or update this admin user safely.
ADMIN_BOOTSTRAP_EMAIL=admin@university.example.edu
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeSecurePass123!
ADMIN_BOOTSTRAP_NAME=System Administrator

# Allowed CORS Origins (comma-separated list for local frontend access)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
